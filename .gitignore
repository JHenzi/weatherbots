.env
*.pdf
gooony.txt
*.pem
*.key
*.p8
.venv/

# Live Postgres data directory — never version the database
pgdata/

# --- Excluded: noise with no learning value (this is what bloated .git) ---
# Logs, the live DB, binary feature caches, and archives. NOT the dataset.
Data/logs/
Data/old/
Data/*.pkl
Data/Archive.zip
Data/.ipynb_checkpoints/
pgoyanka.zip
data_fetcher_new.ipynb

# --- Kept in git: the dataset itself ---
# The forecast/actual/MAE/decision history CSVs are the point of this repo.
# They are tracked as plain (delta-compressed) git blobs, NOT Git LFS.
# Git LFS stored a full copy per commit and is what bloated history to 2.6G;
# do not re-enable it for these files. See Data/README.md for the schema.

# Exception: two bandit-internal logs exceed GitHub's 100MB file limit
# (147MB / 97MB) and grow fastest. They are the model's internal feature/decision
# logs, not the forecast/actual/MAE data. Kept on disk + distributed separately
# (release asset), NOT in git — avoids LFS and the >100MB block. See Data/README.md.
Data/bandit_decisions_history.csv
Data/context_features_history.csv

# requests_cache SQLite backends store full request URLs/params (including API keys) — never commit
*.sqlite
.cache
.cache.sqlite

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
*.pyz
*.pywz
*.pyzw
*.pyzwz

# Backup produced by scripts/regrade_source_performance.py
*.leaked.bak
Data/*.tmp
